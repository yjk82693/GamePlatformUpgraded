// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum AccountStatus {
  ACTIVE
  SUSPENDED
  KICKED
}

enum AppStatus {
  DRAFT
  PUBLISHED
  MAINTENANCE
}

enum Visibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum RoleLevel {
  ORG
  PROJECT
  SERVICE
}

enum Action {
  CREATE
  READ
  UPDATE
  DELETE
  INVITE
  GRANT_ROLE
  REVOKE_ROLE
  REVOKE_MEMBER
  SUSPEND_MEMBER
  UNSUSPEND_MEMBER
  RESET_PASSWORD
  REQUEST
  APPROVE
  REJECT
  CANCEL
  REFUND
  PUBLISH
  EXPORT
  LOGIN
  LOGOUT
}

enum Target {
  ORG
  PROJECT
  APP_SERVICE
  APP
  PRODUCT
  MEMBER
  ROLE
  SECRET_KEY
  SETTING
  PAYMENT_PROJECT
  MERCHANT
  PAYMENT_METHOD
  PAYMENT_SERVICE
  TRANSACTION
  SETTLEMENT
  ANALYTICS
  UI_GUIDE
  NOTIFICATION_SETTING
  CATEGORY
  WEBSHOP_SCREEN
  AUTH_IDP
  AUTH_API
  WEBSHOP_SETTING
}

enum TxnState {
  PAID
  REFUND_PENDING
  REFUNDED
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

enum BoardScope {
  GLOBAL
  FRIENDS
}

enum GameType {
  SOLO
  MULTI
}

enum WidgetMode {
  DEFAULT
  EXPLORE
}

enum ChatKind {
  PLAYER_DIRECT
  STAFF_DIRECT
  GROUP
  SUPPORT
}

enum TicketStatus {
  OPEN
  SOLVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  DONE
}

enum CalScope {
  COMPANY
  PERSONAL
}

enum RollbackStatus {
  PENDING
  APPROVED
}

enum AuthProvider {
  MANUAL
  GOOGLE
  APPLE
}

// ─────────────────────────────────────────────
// Cluster 1 — Identity, structure, RBAC
// ─────────────────────────────────────────────

model Account {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())

  playerProfile PlayerProfile?
  sessions      Session[]
  memberships   Member[]
  accountApps   AccountApp[]

  // Cluster 2
  wallet             Wallet?
  coinLedger         CoinLedger[]
  transactions       Transaction[]
  reviews            Review[]
  demoParticipations DemoParticipation[]
  redeemGrants       RedeemGrant[]
  entitlements       Entitlement[]
  refundRequests     RefundRequest[]

  // Cluster 3
  friendshipsSent     Friendship[]        @relation("FriendshipRequester")
  friendshipsReceived Friendship[]        @relation("FriendshipAddressee")
  scores              Score[]
  achievementUnlocks  AchievementUnlock[]
  gameStatuses        GameStatus[]

  // Cluster 4
  notificationSettings NotificationSetting[]
  reminders            Reminder[]
  consents             Consent[]
  auditLogs            AuditLog[]

  // Cluster 5
  chatParticipations ChatParticipant[]
  sentMessages       ChatMessage[]
  assignedTickets    TicketMeta[]
  calendarEvents     CalendarEvent[]
  tasks              Task[]
  documentVersions   DocumentVersion[]
  documentShares     DocumentShare[]
  rollbackRequests   RollbackRequest[]

  authProvider       AuthProvider @default(MANUAL)
  externalId         String?      @unique
  resetCode          String?
  resetCodeExpiresAt DateTime?
}

model Org {
  id       String    @id @default(cuid())
  name     String
  projects Project[]
  apps     App[]
  members  Member[]
}

model Project {
  id       String       @id @default(cuid())
  orgId    String
  org      Org          @relation(fields: [orgId], references: [id])
  services AppService[]
  members  Member[]
}

model AppService {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  members   Member[]
}

model App {
  id          String       @id @default(cuid())
  name        String
  status      AppStatus    @default(DRAFT)
  releaseDate DateTime?
  ownerOrgId  String
  ownerOrg    Org          @relation(fields: [ownerOrgId], references: [id])
  accountApps AccountApp[]

  // Cluster 2
  builds   Build[]
  products Product[]

  // Cluster 3
  leaderboards      Leaderboard[]
  gameStatuses      GameStatus[]
  achievementGroups AchievementGroup[]

  // Cluster 4
  notices    Notice[]
  liveEvents LiveEvent[]
}

model AccountApp {
  accountId String
  appId     String
  account   Account @relation(fields: [accountId], references: [id])
  app       App     @relation(fields: [appId], references: [id])

  @@id([accountId, appId])
}

model Session {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  token     String   @unique
  issuedAt  DateTime @default(now())
  expiresAt DateTime
}

model PlayerProfile {
  accountId         String        @id
  account           Account       @relation(fields: [accountId], references: [id])
  displayName       String
  avatarRef         String?
  visibility        Visibility    @default(PUBLIC)
  friendCode        String        @unique
  selectedPersonaId String?
  status            AccountStatus @default(ACTIVE)
}

model Member {
  id           String       @id @default(cuid())
  accountId    String
  account      Account      @relation(fields: [accountId], references: [id])
  orgId        String?
  org          Org?         @relation(fields: [orgId], references: [id])
  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id])
  appServiceId String?
  appService   AppService?  @relation(fields: [appServiceId], references: [id])
  roles        MemberRole[]
}

model Role {
  id          String       @id @default(cuid())
  name        String
  level       RoleLevel
  permissions Permission[]
  memberRoles MemberRole[]
}

model MemberRole {
  memberId String
  roleId   String
  member   Member @relation(fields: [memberId], references: [id])
  role     Role   @relation(fields: [roleId], references: [id])

  @@id([memberId, roleId])
}

model Permission {
  id         String @id @default(cuid())
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id])
  action     Action
  targetType Target
}

model SecretKey {
  id        String   @id @default(cuid())
  appId     String
  keyHash   String
  createdAt DateTime @default(now())
}

model Setting {
  id    String @id @default(cuid())
  scope String
  key   String
  value String
}

// ─────────────────────────────────────────────
// Cluster 2 — Commerce & wallet
// ─────────────────────────────────────────────

model Wallet {
  accountId String  @id
  account   Account @relation(fields: [accountId], references: [id])
  cashCents BigInt  @default(0)
  coinUnits BigInt  @default(0)
}

model CoinLedger {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  delta     BigInt
  reason    String
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String
  products Product[]
}

model Product {
  id           String        @id @default(cuid())
  appId        String
  app          App           @relation(fields: [appId], references: [id])
  name         String
  enabled      Boolean       @default(false)
  priceCents   Int?
  priceCoins   Int?
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id])
  items        Item[]
  transactions Transaction[]
  entitlements Entitlement[]
  reviews      Review[]
}

model Item {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  enabled   Boolean @default(true)
}

model Transaction {
  id            String         @id @default(cuid())
  accountId     String
  account       Account        @relation(fields: [accountId], references: [id])
  productId     String
  product       Product        @relation(fields: [productId], references: [id])
  receiptId     String         @unique
  state         TxnState       @default(PAID)
  occurredAt    DateTime       @default(now())
  refundRequest RefundRequest?
}

model Merchant {
  id             String          @id @default(cuid())
  name           String
  config         Json?
  paymentMethods PaymentMethod[]
}

model PaymentMethod {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  type       String
}

model PaymentService {
  id     String @id @default(cuid())
  name   String
  config Json?
}

model Settlement {
  id        String   @id @default(cuid())
  period    String
  payload   Json?
  createdAt DateTime @default(now())
}

model Payout {
  id        String   @id @default(cuid())
  period    String
  amount    BigInt
  createdAt DateTime @default(now())
}

model RefundRequest {
  id          String      @id @default(cuid())
  txnId       String      @unique
  transaction Transaction @relation(fields: [txnId], references: [id])
  requestedBy String
  requester   Account     @relation(fields: [requestedBy], references: [id])
  createdAt   DateTime    @default(now())
}

model Review {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  rating    Int
  body      String?

  @@unique([accountId, productId])
}

model Demo {
  id              String              @id @default(cuid())
  surveyQuestions Json
  participations  DemoParticipation[]
}

model DemoParticipation {
  demoId    String
  accountId String
  demo      Demo    @relation(fields: [demoId], references: [id])
  account   Account @relation(fields: [accountId], references: [id])
  answers   Json

  @@id([demoId, accountId])
}

model RedeemCode {
  id       String        @id @default(cuid())
  code     String        @unique
  reward   Json
  usesLeft Int
  expiry   DateTime?
  grants   RedeemGrant[]
}

model RedeemGrant {
  codeId    String
  accountId String
  code      RedeemCode @relation(fields: [codeId], references: [id])
  account   Account    @relation(fields: [accountId], references: [id])

  @@id([codeId, accountId])
}

model Build {
  id        String  @id @default(cuid())
  appId     String
  app       App     @relation(fields: [appId], references: [id])
  version   String
  checksum  String
  published Boolean @default(false)
}

model Entitlement {
  accountId String
  productId String
  account   Account @relation(fields: [accountId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@id([accountId, productId])
}

// ─────────────────────────────────────────────
// Cluster 3 — Game profile, social, ranking
// ─────────────────────────────────────────────

model Friendship {
  id          String       @id @default(cuid())
  requesterId String
  addresseeId String
  requester   Account      @relation("FriendshipRequester", fields: [requesterId], references: [id])
  addressee   Account      @relation("FriendshipAddressee", fields: [addresseeId], references: [id])
  status      FriendStatus @default(PENDING)

  @@unique([requesterId, addresseeId])
}

model Leaderboard {
  id     String  @id @default(cuid())
  appId  String
  app    App     @relation(fields: [appId], references: [id])
  name   String
  season Int     @default(1)
  closed Boolean @default(false)
  scores Score[]
}

model Score {
  id          String      @id @default(cuid())
  boardId     String
  board       Leaderboard @relation(fields: [boardId], references: [id])
  accountId   String
  account     Account     @relation(fields: [accountId], references: [id])
  value       Int
  submittedAt DateTime    @default(now())

  @@unique([boardId, accountId])
}

model AchievementGroup {
  id           String        @id @default(cuid())
  name         String
  appId        String?
  app          App?          @relation(fields: [appId], references: [id])
  achievements Achievement[]
}

model Achievement {
  id      String              @id @default(cuid())
  groupId String
  group   AchievementGroup    @relation(fields: [groupId], references: [id])
  name    String
  unlocks AchievementUnlock[]
}

model AchievementUnlock {
  achievementId String
  accountId     String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  account       Account     @relation(fields: [accountId], references: [id])
  unlockedAt    DateTime    @default(now())

  @@id([achievementId, accountId])
}

model GameStatus {
  accountId String
  appId     String
  account   Account  @relation(fields: [accountId], references: [id])
  app       App      @relation(fields: [appId], references: [id])
  gameType  GameType
  data      Json

  @@id([accountId, appId])
}

// ─────────────────────────────────────────────
// Cluster 4 — Console-domain, engagement, support, legal
// ─────────────────────────────────────────────

model Analytics {
  id      String   @id @default(cuid())
  name    String
  metrics Metric[]
}

model Metric {
  id          String    @id @default(cuid())
  analyticsId String
  analytics   Analytics @relation(fields: [analyticsId], references: [id])
  key         String
  value       Json
}

model Dashboard {
  id         String   @id @default(cuid())
  ownerScope String
  widgets    Widget[]
}

model Widget {
  id          String     @id @default(cuid())
  dashboardId String
  dashboard   Dashboard  @relation(fields: [dashboardId], references: [id])
  mode        WidgetMode @default(DEFAULT)
  type        String
  xAxis       String
  yAxis       String
  query       Json
  position    Int
}

model NotificationSetting {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  channel   String
  enabled   Boolean @default(true)
}

model Notice {
  id        String    @id @default(cuid())
  appId     String
  app       App       @relation(fields: [appId], references: [id])
  content   String
  audience  String
  schedule  DateTime?
  createdAt DateTime  @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}

model LiveEvent {
  id       String   @id @default(cuid())
  appId    String
  app      App      @relation(fields: [appId], references: [id])
  config   Json
  startsAt DateTime
  endsAt   DateTime
}

model Reminder {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  source    String
  dueAt     DateTime
}

model Terms {
  id            String    @id @default(cuid())
  version       String    @unique
  content       String
  effectiveDate DateTime
  active        Boolean   @default(false)
  consents      Consent[]
}

model Consent {
  accountId   String
  termsId     String
  account     Account  @relation(fields: [accountId], references: [id])
  terms       Terms    @relation(fields: [termsId], references: [id])
  consentedAt DateTime @default(now())

  @@id([accountId, termsId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      Account  @relation(fields: [actorId], references: [id])
  action     Action
  targetType Target
  targetId   String
  payload    Json?
  occurredAt DateTime @default(now())
  success    Boolean
}

model DeadLetter {
  id       String   @id @default(cuid())
  original Json
  reason   String
  failedAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// Cluster 5 — Chat spine & co-op
// ─────────────────────────────────────────────

model ChatThread {
  id           String            @id @default(cuid())
  kind         ChatKind
  scope        String?
  participants ChatParticipant[]
  messages     ChatMessage[]
  ticketMeta   TicketMeta?
}

model ChatParticipant {
  threadId  String
  accountId String
  thread    ChatThread @relation(fields: [threadId], references: [id])
  account   Account    @relation(fields: [accountId], references: [id])

  @@id([threadId, accountId])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id])
  senderId  String
  sender    Account    @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime   @default(now())
}

model TicketMeta {
  threadId   String       @id
  thread     ChatThread   @relation(fields: [threadId], references: [id])
  status     TicketStatus @default(OPEN)
  assigneeId String?
  assignee   Account?     @relation(fields: [assigneeId], references: [id])
}

model CalendarEvent {
  id      String   @id @default(cuid())
  scope   CalScope
  title   String
  start   DateTime
  end     DateTime
  ownerId String
  owner   Account  @relation(fields: [ownerId], references: [id])
  tasks   Task[]
}

model Task {
  id              String         @id @default(cuid())
  scope           String
  title           String
  assigneeId      String?
  assignee        Account?       @relation(fields: [assigneeId], references: [id])
  priority        TaskPriority   @default(MEDIUM)
  status          TaskStatus     @default(TODO)
  completedAt     DateTime?
  dueDate         DateTime?
  calendarEventId String?
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id])
}

model Document {
  id             String            @id @default(cuid())
  workspaceId    String
  path           String
  currentVersion Int               @default(1)
  versions       DocumentVersion[]
  shares         DocumentShare[]
  rollbacks      RollbackRequest[]
}

model DocumentVersion {
  documentId String
  version    Int
  document   Document @relation(fields: [documentId], references: [id])
  blobRef    String
  authorId   String
  author     Account  @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())

  @@id([documentId, version])
}

model DocumentShare {
  docId    String
  memberId String
  doc      Document @relation(fields: [docId], references: [id])
  member   Account  @relation(fields: [memberId], references: [id])
  access   String

  @@id([docId, memberId])
}

model RollbackRequest {
  id            String         @id @default(cuid())
  docId         String
  doc           Document       @relation(fields: [docId], references: [id])
  targetVersion Int
  byId          String
  by            Account        @relation(fields: [byId], references: [id])
  status        RollbackStatus @default(PENDING)
}
